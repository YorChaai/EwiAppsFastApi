        content: SizedBox(
          width: 350,
          child: TextField(
            controller: nameCtrl,
            decoration: InputDecoration(
              labelText: parentId != null
                  ? 'Nama Sub Kategori'
                  : 'Nama Kategori',
            ),
            style: TextStyle(color: AppTheme.textPrimary),
            autofocus: true,
          ),
