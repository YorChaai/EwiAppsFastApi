                          }
                        }
                      }
                    },
                  ),
                  const SizedBox(height: 12),
                  // mata uang
                  Row(
                    children: [
                      Expanded(
                        flex: 2,
                        child: DropdownButtonFormField<String>(
                          decoration: InputDecoration(labelText: 'Mata Uang'),
                          dropdownColor: AppTheme.card,
                          style: TextStyle(color: AppTheme.textPrimary),
