                                'Buat Sub Kategori (+)',
                                style: TextStyle(color: AppTheme.warning),
                              )
                            : null,
                        disabledHint: const Text('Pilih Kategori Utama dulu'),
                        items: isEnabled && children.isNotEmpty
                            ? children
