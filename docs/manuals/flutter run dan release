                                                          style: const TextStyle(fontSize: 10, color: AppTheme.primary, fontWeight: FontWeight.bold),
                                                        ),
                                                      ),
                                                    ),
                                                  ],
                                                );
                                              } catch (e) {
                                                // Fallback
                                              }
                                            }

                                          return Text(
                                            (exp['status'] as String).toUpperCase(),
                                            style: TextStyle(
                                              fontSize: 11,
                                              fontWeight: FontWeight.w700,
                                              color: _statusColor(exp['status']),
                                            ),
                                          );
                                        }),
