                                                List<dynamic> checklist = [];
                                                final parsedNotes = notes is String && notes.startsWith('[')
                                                    ? jsonDecode(notes)
                                                    : notes;

                                                if (parsedNotes is List) {
                                                  checklist = List<dynamic>.from(parsedNotes);
