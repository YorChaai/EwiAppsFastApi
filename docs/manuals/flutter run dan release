    _statusFilter = status;
    if (startDate != null) _startDate = startDate;
    if (endDate != null) _endDate = endDate;
    if (reportYear != null) {
      _reportYear = reportYear;
    } else {
      _reportYear = DateTime.now().year;
    }
    if (search != null) _searchQuery = search;

    _loading = true;
    _error = null;

    try {
      final params = <String, dynamic>{};
      if (_statusFilter != null) params['status'] = _statusFilter;
      if (_startDate != null) params['startDate'] = _startDate;
      if (_endDate != null) params['endDate'] = _endDate;
      params['reportYear'] = _reportYear;

      final searchQuery = _searchQuery ?? '';
      if (searchQuery.isNotEmpty) {
        final sanitized = searchQuery
            .replaceAll('<', '')
            .replaceAll('>', '')
            .replaceAll('"', '')
            .replaceAll("'", '')
            .replaceAll('&', '')
            .replaceAll(';', '');
        params['search'] = sanitized;
      }

      final res = await _api.getSettlements(
        status: _statusFilter,
        startDate: _startDate,
        endDate: _endDate,
        type: type,
        reportYear: _reportYear,
        search: _searchQuery,
      );
      _settlements = List<Map<String, dynamic>>.from(res['settlements']);
    } catch (e) {
      _error = e.toString().replaceAll('Exception: ', '');
    }

    _loading = false;
    notifyListeners();
  }

