    int? selectedSubCategoryId;
    final targetId = exp['category_id'] as int?;

    if (targetId != null) {
      // cek kategori utama atau child
      for (final p in allCats) {
        if (p['id'] == targetId) {
          selectedParentId = p['id'];
          break;
        }
        final children = (p['children'] as List?) ?? [];
        for (final c in children) {
