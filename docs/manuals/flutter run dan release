                                            overflow: TextOverflow.ellipsis,
                                          ),
                                        ),
                                      ),
                                      DataCell(Text(_formatExpenseAmount(exp))),
                                      DataCell(
                                        exp['evidence_path'] != null
                                            ? IconButton(
                                                icon: Icon(
                                                  Icons.image_rounded,
                                                  color: AppTheme.accent,
                                                  size: 20,
                                                ),
                                                tooltip: 'Lihat Bukti',
                                                onPressed: () => _showEvidence(
