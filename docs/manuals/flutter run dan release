    // Karena kalau sudah dispose, context.read akan error
    try {
      if (mounted) {
        context.read<NotificationProvider>().stopPolling();
      }
    } catch (_) {
      // Silent fail - provider mungkin sudah tidak tersedia
    }

    super.dispose();
