                    style: TextStyle(color: AppTheme.textPrimary),
                    onChanged: (val) {
                      final lower = val.toLowerCase();
    // isi kategori awal
                      for (final p in allCats) {
      // cek nama parent
                        if (lower.contains(
                          p['name'].toString().toLowerCase(),
                        )) {
                          setDialogState(() {
                            selectedParentId = p['id'];
                            selectedSubCategoryId = null;
