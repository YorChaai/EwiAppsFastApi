                        style: TextStyle(
                          color: _titleColor(context),
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Consumer<NotificationProvider>(
                            builder: (context, notifProvider, _) {
                              return IconButton(
                                tooltip: 'Tandai semua dibaca',
