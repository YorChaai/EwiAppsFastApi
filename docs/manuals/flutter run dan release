class ApiService {
  final Map<String, _CachedResponse> _cache = {};
  
  Future<Map<String, dynamic>> getCategories() async {
    // Check cache first (5 minutes validity)
    final cached = _cache['categories'];
    if (cached != null && !cached.isExpired) {
      return cached.data;
    }
    
    final res = await http.get(
      Uri.parse('$baseUrl/expenses/categories'),
      headers: _headers,
    );
    final result = _handleResponse(res);
    
    // Cache for 5 minutes
    _cache['categories'] = _CachedResponse(
      result,
      DateTime.now().add(const Duration(minutes: 5)),
    );
    
    return result;
  }
}

class _CachedResponse {
  final Map<String, dynamic> data;
  final DateTime expiresAt;
  
  _CachedResponse(this.data, this.expiresAt);
  
  bool get isExpired => DateTime.now().isAfter(expiresAt);
}
```

